      "boundElements": [],
      "updated": 1781863234256,
      "link": null,
      "locked": false,
      "fontSize": 14,
      "fontFamily": 2,
      "text": "KEY FINDINGS:\n  \u2022 Hybrid now uses BGE embeddings with weight .30 and is best overall for @3/@5/@10/@15 ranking\n  \u2022 BGE is strongest single model; Hybrid BGE is best overall after combining retrieval signals\n  \u2022 MiniLM embeddings underperform; BGE embeddings are strong and improve the Hybrid model\n  \u2022 GPT-OSS 3-pass pipeline produced 1,500 calibrated rows; labels are well-balanced: 2=48.5%, 1=48.9%, 0=2.5%\n\nEND-TO-END DATA FLOW:\n  AniList API  \u2192  anime_full.csv  (22,234 \u00d7 25)\n  anime_full.csv  \u2192  clean_data.py  \u2192  anime_clean.csv  (21,901 \u00d7 27)  [+genres_list, +tags_list]\n  anime_full.csv  \u2192  prepare_candidates.py  \u2192  recommendation_candidates.csv  (3,961 rows)\n  recommendation_candidates.csv  \u2192  GPT-OSS 3-pass  \u2192  final_cleaned_annotated_set.csv  (1,500 \u00d7 12)\n  anime_clean.csv  \u2192  5 method variants  \u2192  evaluated vs test set  \u2192  Hybrid+BGE best @3/@5/@10/@15 NDCG\n  Hybrid recommender  \u2192  Flask /api/recommend  \u2192  {id, title, score, genres, tags, cover_image}[]",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "KEY FINDINGS:\n  \u2022 Hybrid now uses BGE embeddings with weight .30 and is best overall for @3/@5/@10/@15 ranking\n  \u2022 BGE is strongest single model; Hybrid BGE is best overall after combining retrieval signals\n  \u2022 MiniLM embeddings underperform; BGE embeddings are strong and improve the Hybrid model\n  \u2022 GPT-OSS 3-pass pipeline produced 1,500 calibrated rows; labels are well-balanced: 2=48.5%, 1=48.9%, 0=2.5%\n\nEND-TO-END DATA FLOW:\n  AniList API  \u2192  anime_full.csv  (22,234 \u00d7 25)\n  anime_full.csv  \u2192  clean_data.py  \u2192  anime_clean.csv  (21,901 \u00d7 27)  [+genres_list, +tags_list]\n  anime_full.csv  \u2192  prepare_candidates.py  \u2192  recommendation_candidates.csv  (3,961 rows)\n  recommendation_candidates.csv  \u2192  GPT-OSS 3-pass  \u2192  final_cleaned_annotated_set.csv  (1,500 \u00d7 12)\n  anime_clean.csv  \u2192  5 method variants  \u2192  evaluated vs test set  \u2192  Hybrid+BGE best @3/@5/@10/@15 NDCG\n  Hybrid recommender  \u2192  Flask /api/recommend  \u2192  {id, title, score, genres, tags, cover_image}[]",
      "autoResize": false,
      "lineHeight": 1.25,
      "baseline": 11,
      "index": "b0t"
    },
