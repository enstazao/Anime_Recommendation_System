    {
      "id": "t5708456",
      "type": "text",
      "x": 110,
      "y": 264,
      "width": 470,
      "height": 373.75,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
