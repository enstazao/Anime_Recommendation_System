    {
      "id": "t959074",
      "type": "text",
      "x": 974,
      "y": 2008,
      "width": 396,
      "height": 373.75,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
