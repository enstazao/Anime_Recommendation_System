    {
      "id": "t3965789",
      "type": "text",
      "x": 110,
      "y": 2008,
      "width": 396,
      "height": 357.5,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
