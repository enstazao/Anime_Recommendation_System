      "seed": 1193448330,
      "version": 3,
      "versionNonce": 458383684,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1781864226304,
      "link": null,
      "locked": false,
      "fontSize": 13,
      "fontFamily": 2,
      "text": "ENDPOINT: POST https://graphql.anilist.co\nVARIABLES: page: Int, perPage: 50, sort: POPULARITY_DESC\n\nFIELDS REQUESTED per media item:\n  id \u00b7 idMal\n  title { romaji  english  native }\n  type \u00b7 format \u00b7 source\n  episodes \u00b7 duration\n  status \u00b7 season \u00b7 seasonYear\n  startDate { year month day }\n  endDate   { year month day }\n  averageScore \u00b7 meanScore\n  popularity \u00b7 favourites\n  genres\n  tags { name  rank }\n  studios { nodes { name } }\n  description (asHtml: false)\n  coverImage { large }\n  isAdult\n\nRESPONSE ENVELOPE:\n  Page.pageInfo { currentPage, hasNextPage }\n  Page.media [ \u2026 ]",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ENDPOINT: POST https://graphql.anilist.co\nVARIABLES: page: Int, perPage: 50, sort: POPULARITY_DESC\n\nFIELDS REQUESTED per media item:\n  id \u00b7 idMal\n  title { romaji  english  native }\n  type \u00b7 format \u00b7 source\n  episodes \u00b7 duration\n  status \u00b7 season \u00b7 seasonYear\n  startDate { year month day }\n  endDate   { year month day }\n  averageScore \u00b7 meanScore\n  popularity \u00b7 favourites\n  genres\n  tags { name  rank }\n  studios { nodes { name } }\n  description (asHtml: false)\n  coverImage { large }\n  isAdult\n\nRESPONSE ENVELOPE:\n  Page.pageInfo { currentPage, hasNextPage }\n  Page.media [ \u2026 ]",
      "autoResize": false,
      "lineHeight": 1.25,
      "baseline": 11,
      "index": "a8"
    },
