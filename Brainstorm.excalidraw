      "autoResize": false,
      "lineHeight": 1.25,
      "baseline": 12,
      "index": "b0i"
    },
    {
      "id": "t6194416",
      "type": "text",
      "x": 570,
      "y": 3042,
      "width": 660,
      "height": 258,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 636057976,
      "version": 2,
      "versionNonce": 622018500,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1781863234256,
      "link": null,
      "locked": false,
      "fontSize": 13,
      "fontFamily": 2,
      "text": "ENDPOINT: GET /api/recommend\n\nREQUEST PARAMS:\n  model  (str)  tfidf|bm25f|embedding|hybrid\n  id     (str)  AniList anime id  (preferred)\n  q      (str)  title fallback if no id\n  top_k  (int)  results count  (default 10)\n\nPROCESSING:\n  If no id \u2192 best_title_match(q) \u2192 id\n  recommender.recommend_by_id(id, top_k)\n  Fetch source metadata from catalog\n\nRESPONSE (JSON):\n  { \"source\": { \"id\", \"title\",\n                \"title_english\", \"cover_image\" },\n    \"model\": \"hybrid\",\n    \"model_label\": \"Hybrid\",\n    \"recommendations\": [\n      { \"id\", \"title\", \"title_english\",\n        \"score\", \"genres\", \"tags\",\n        \"cover_image\" }, ...\n    ] }",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ENDPOINT: GET /api/recommend\n\nREQUEST PARAMS:\n  model  (str)  tfidf|bm25f|embedding|hybrid\n  id     (str)  AniList anime id  (preferred)\n  q      (str)  title fallback if no id\n  top_k  (int)  results count  (default 10)\n\nPROCESSING:\n  If no id \u2192 best_title_match(q) \u2192 id\n  recommender.recommend_by_id(id, top_k)\n  Fetch source metadata from catalog\n\nRESPONSE (JSON):\n  { \"source\": { \"id\", \"title\",\n                \"title_english\", \"cover_image\" },\n    \"model\": \"hybrid\",\n    \"model_label\": \"Hybrid\",\n    \"recommendations\": [\n      { \"id\", \"title\", \"title_english\",\n        \"score\", \"genres\", \"tags\",\n        \"cover_image\" }, ...\n    ] }",
      "autoResize": false,
      "lineHeight": 1.25,
      "baseline": 11,
      "index": "b0j"
    },
