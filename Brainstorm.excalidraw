    {
      "id": "t4449368",
      "type": "text",
      "x": 542,
      "y": 2008,
      "width": 396,
      "height": 328,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
