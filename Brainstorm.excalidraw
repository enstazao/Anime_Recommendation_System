      "locked": false,
      "fontSize": 13,
      "fontFamily": 2,
      "text": "FILE: RecommendationSystem/index.html\nSERVED BY: GET /\n\nUI FLOW:\n  1. User types title\n  2. /api/search \u2192 autocomplete list\n  3. User picks model (dropdown)\n  4. /api/recommend returns results\n  5. Renders grid of anime cards:\n       cover_image  (thumbnail)\n       title + title_english\n       genres (badges)\n       similarity score\n\nDROPDOWN OPTIONS:\n  Hybrid  \u00b7  BM25F  \u00b7  TF-IDF\n  MiniLM Embeddings  \u00b7  BGE Embeddings",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "FILE: RecommendationSystem/index.html\nSERVED BY: GET /\n\nUI FLOW:\n  1. User types title\n  2. /api/search \u2192 autocomplete list\n  3. User picks model (dropdown)\n  4. /api/recommend returns results\n  5. Renders grid of anime cards:\n       cover_image  (thumbnail)\n       title + title_english\n       genres (badges)\n       similarity score\n\nDROPDOWN OPTIONS:\n  Hybrid  \u00b7  BM25F  \u00b7  TF-IDF\n  MiniLM Embeddings  \u00b7  BGE Embeddings",
      "autoResize": false,
      "lineHeight": 1.25,
      "baseline": 11,
      "index": "b0n"
    },
