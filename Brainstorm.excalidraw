    {
      "id": "t6774229",
      "type": "text",
      "x": 1406,
      "y": 2008,
      "width": 424,
      "height": 328,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
